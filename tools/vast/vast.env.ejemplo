# Copie a tools/vast/vast.env (ignorado por Git) y ajuste IP y puerto: cambian cada vez que la instancia se inicia.
# Se obtienen en la consola de Vast.ai → instancia → «Connect» (línea ssh -p PUERTO root@IP).
VAST_HOST=97.117.6.187
VAST_PUERTO=40234
VAST_LLAVE=$HOME/.ssh/vast_59585596
VAST_PAQUETE=/workspace/ora_restore_4080/proyecto_ora/paquete
VAST_BLENDER=/workspace/blender-5.2.3-linux-x64/blender
RESPALDO_MAC=$HOME/Downloads/ora-vast-respaldo
# Escenas que ninguna tarea puede modificar (se comprueban por SHA-256 en cada preflight)
PROTEGIDAS="escena/escena_splat.blend escena/escena_splat_v2.blend v4/escena_v4.blend v4/escena_v4_1.blend"
DISCO_MIN_GB=5
