{
  "name": "ora-ai-explorer",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.cjs",
    "build:prototype": "esbuild prototype/src/app.mjs --bundle --format=esm --target=es2020 --sourcemap --outfile=prototype/dist/app.js",
    "start:prototype": "npm run build:prototype && PORT=8770 node server.mjs",
    "test:prototype": "npm run build:prototype && node --test prototype/tests/*.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
